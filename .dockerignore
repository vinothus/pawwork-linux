# PawWork Linux test image — keep the build context small and the image free
# of host artifacts. Everything here is recreated inside the image anyway.

# VCS
.git
.gitattributes
.gitignore

# Dependencies & build output (recreated inside the image)
**/node_modules
**/out
**/dist
**/build
**/.vite
**/.turbo
**/coverage
packages/desktop-electron/release
.node-version

# Package manager
.pnpm-store
pnpm-debug.log*

# Editor / OS junk
.DS_Store
Thumbs.db
*.log